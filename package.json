{
  "name": "ai-video-editor",
  "version": "0.1.0",
  "description": "AI-powered automated video editing pipeline for travel vlogs",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "test:bpm": "node --loader ts-node/esm src/tests/test-bpm.ts",
    "test:ffmpeg": "node --loader ts-node/esm src/tests/test-ffmpeg.ts",
    "extract:video": "node --loader ts-node/esm src/cli/extract-video.ts",
    "analyze:audio": "python3 src/audio_analysis.py",
    "edit:auto": "node --loader ts-node/esm src/cli/auto-edit.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "keywords": [
    "video",
    "editing",
    "ffmpeg",
    "ai",
    "claude",
    "automation"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.21.0",
    "dotenv": "^16.3.1",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
