# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# FFmpeg Configuration
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Audio Analysis
AUDIO_SR=22050
AUDIO_N_FFT=2048

# Video Processing
DEFAULT_VIDEO_CODEC=libx264
DEFAULT_AUDIO_CODEC=aac
OUTPUT_QUALITY=23

# Processing Limits
MAX_FRAMES_ANALYZE=30
MAX_VIDEOS_BATCH=5
MAX_VIDEO_RESOLUTION=1280x720

# Directories
RAW_CLIPS_DIR=./raw_clips
AUDIO_DIR=./audio
OUTPUT_DIR=./output
TEMP_DIR=./temp
CACHE_DIR=./.cache

# Logging
LOG_LEVEL=info
VERBOSE=false
