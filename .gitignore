# Dependencies
node_modules/
package-lock.json
yarn.lock
.pnp

# Build outputs
dist/
*.tsbuildinfo
*.js
!src/**/*.js

# Environment variables
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.vscode/
.idea/
*.iml
*.sublime-*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Media files (large, not committed)
/raw_clips/*
!/raw_clips/.gitkeep
/audio/*
!/audio/.gitkeep
/output/*
!/output/.gitkeep
/temp/*
!/temp/.gitkeep
/.cache/*
!/cache/.gitkeep

# Analysis outputs (can be regenerated)
analysis.json
*_analysis.json
*_edit_plan.json
*.mp3
*.wav
*.mp4
*.mov

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
